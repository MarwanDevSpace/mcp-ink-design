{
  "name": "mcp-ink-design",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server for high-craft web design, anti-AI-slop typography & OKLCH color palettes, Three.js 3D scenes, frontend security audits, and Python-backed verification.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-ink-design": "./bin/mcp-ink-design.js"
  },
  "files": [
    "dist",
    "bin",
    "INK_MASTER.md",
    "python",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m unittest discover -s python/test",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarwanDevSpace/mcp-ink-design.git"
  },
  "bugs": {
    "url": "https://github.com/MarwanDevSpace/mcp-ink-design/issues"
  },
  "homepage": "https://github.com/MarwanDevSpace/mcp-ink-design#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-design",
    "css",
    "threejs",
    "anti-ai-slop",
    "oklch",
    "security-audit",
    "python-verification"
  ],
  "author": "MarwanDevMCP",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
